# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in each value.
# .env.local is gitignored; never commit real credentials.
# Nothing here has a NEXT_PUBLIC_ prefix except NEXT_PUBLIC_SITE_URL, which
# means none of these secrets can end up in a browser bundle.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string.
# Atlas → your cluster → Connect → Drivers. Use the same cluster as the old
# site so the existing Projects collection is reused with no migration.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.pr3rbd0.mongodb.net/?retryWrites=true&w=majority"

# Database name. The previous Express server used "souravPortfolio"; keep it
# unless you deliberately want a different database.
MONGODB_DB="souravPortfolio"

# Signs the session cookie. Generate one with: npx auth secret
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""

# Canonical URL of the deployment. Used for absolute URLs in metadata, and by
# Auth.js to build callback URLs. No trailing slash.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# The single admin account. There is no users collection and no sign-up.
# ---------------------------------------------------------------------------

# The email you will type into /admin/login.
ADMIN_EMAIL="you@example.com"

# Display name shown in the dashboard sidebar. Optional.
ADMIN_NAME="Sourav"

# bcrypt hash of your password. Generate it with:
#   npm run hash -- "your-password-here"
# Wrap it in single quotes: a bcrypt hash contains $ characters.
ADMIN_PASSWORD_HASH=''

# Local-development convenience only. If ADMIN_PASSWORD_HASH is set it wins.
# Leave this empty in any deployed environment.
ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Cloudinary — image uploads. Read only on the server, inside /api/upload.
# Dashboard → Programmable Media → API Keys.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Folder that uploads are filed under in your Cloudinary media library.
CLOUDINARY_FOLDER="sourav-portfolio"
